Name       U71_modified.pld;
Partno     U71;
Date       ;
Revision   ;
Designer   ;
Company    ;
Assembly   ;
Location   ;
Device     P22V10;
//          20L8

/* INPUT PINS */
PIN  1 = A22;
PIN  2 = A21;
PIN  3 = A20;
PIN  4 = A19;
PIN  5 = A18;
PIN  6 = A17;
PIN  7 = A16;
PIN  8 = A23;
PIN  9 = i9;
PIN  10 = W_R;
PIN  11 = DACK0;
PIN  14 = ROMCACHE;
PIN  23 = _A20EN;
PIN  13 = i13;
PIN  16 = MAENA_BA;

/* OUTPUT PINS */
PIN  15 = RAS_EN_4M;
PIN  17 = _MA7C;
PIN  18 = _MA8a;
PIN  19 = _32BIT_EN;
PIN  20 = RAS_EN_SYS;
PIN  21 = 4MB_2;
PIN  22 = 4MB_3;

/* LOGIC EQUATIONS */

!_MA7C = (A22 & !A18) #
       (A21 & !A18) #
       (!A18 & _A20EN) #
       (!A18 & A17) #
       (A19 & !A18) #
       (!A20 & !A18);

!_MA8a = (A22 & !A19) #
       (!A19 & _A20EN) #
       (!A19 & A18) #
       (A21 & !A19) #
       (!A20 & !A19);

!_32BIT_EN = (
       (!A23 & !A22 & !A21 & !A20 & !A19 & i13) #                                          //00000-7FFFF        0-512k
       (!A23 & !A22 & !A21 & !A20 & A19 & !A18 & !A17 & i13) #                             //80000-9FFFF        512-640k
       (!A23 & !A22 & !A21 & !A20 & A19 & A18 & A17 & A16 & !W_R & ROMCACHE &i13) #        //F0000-FFFFF        960-1024k
       (!A23 & !A22 & !A21 & A20 & !A19 & i13) #                                           //100000-17FFFF      1024-1536k
       (!A23 & !A22 & !A21 & A20 & A19 & !A18 & !A17 & i13) #                              //180000-19FFFF      1536-1664k
       (!A23 & !A22 & !A21 & A20 & A19 & !_A20EN & i13) #                                  //180000-1FFFFF      1536-2028k
       (!A23 & A21 & i13) #                                                                //200000-3FFFFF      2-4M
       (!A23 & A22 & i13) #                                                                //400000-7FFFFF      4-8M
       (A23 & !A22 & i13) #                                                                //800000-BFFFFF      8-12M
       (A23 & !A21 & i13) #                                                                //C00000-DFFFFF      12-14M
       (A23 & !A20 & i13) #                                                                //E00000-EFFFFF      14-15M
       (A23 & ROMCACHE & i13)                                                              //F00000-FFFFFF      15-16M
       );

//1MB onboard
!RAS_EN_SYS = (A23 & A22 & A21 & A20 & A19 & A18 & A17 & A16 & i9 & !W_R & ROMCACHE) #     //FF0000-FFFFFF
       (!A23 & !A22 & !A21 & !A19 & !A18 & i9) #                                           //000000-3FFFF, 100000-13FFFF
       (!A23 & !A22 & !A21 & i9 & _A20EN) #                                                //000000-1FFFFF
       (!A23 & !A22 & !A21 & !A20 & i9) #                                                  //000000-0FFFFF
       //(!A23 & A22 & !A21 & A20 & A19 & i9 & !ROMCACHE) #                                //580000-5FFFFF
       (!MAENA_BA);

//1MB ext1
!RAS_EN_1M_1 = (DACK0 & !MAENA_BA) #
       (!A23 & !A22 & A21 & !A20 & !A19 & !A18 & i9 & MAENA_BA) #                          //200000-23FFFF
       (!A23 & !A22 & !A21 & A20 & A18 & i9 & MAENA_BA & !_A20EN) #                        //140000-17FFFF, 1C0000-1FFFFF
       (!A23 & !A22 & !A21 & A20 & A19 & i9 & MAENA_BA & !_A20EN);                         //180000-1FFFFF

//1MB ext2
!RAS_EN_1M_2 = (DACK0 & !MAENA_BA) #
       (!A23 & !A22 & A21 & A20 & !A19 & !A18 & i9 & MAENA_BA) #                           //300000-33FFFF
       (!A23 & !A22 & A21 & !A20 & A18 & i9 & MAENA_BA) #                                  //240000-27FFFF, 2C0000-2FFFFF
       (!A23 & !A22 & A21 & !A20 & A19 & i9 & MAENA_BA);                                   //280000-2FFFFF
       
//4MB ext1
!RAS_EN_4M = (!A23 & A22 & !A21 & !A19 & !A18 & i9 & MAENA_BA) #                           //400000-43FFFF, 500000-53FFFF
       (!A23 & !A22 & A20 & A18 & i9 & MAENA_BA & !_A20EN) #                               //140000-17FFFF, 1C0000-1FFFFF, 340000-37FFFF, 3C0000-3FFFFF
       (!A23 & !A22 & A20 & A19 & i9 & MAENA_BA & !_A20EN) #                               //180000-1FFFFF, 380000-3FFFFF
       (!A23 & !A22 & A21 & i9 & MAENA_BA) #                                               //200000-3FFFFF
       (!A23 & A22 & !A21 & !A20 & i9 & MAENA_BA) #                                        //400000-4FFFFF
       (DACK0 & !MAENA_BA);

//4MB ext2
!4MB_2 = (A23 & !A22 & !A21 & !A19 & !A18 & i9 & MAENA_BA) #                               //800000-83FFFF, 900000-93FFFF
       (!A23 & A22 & A20 & A18 & i9 & MAENA_BA & !_A20EN) #                                //540000-57FFFF, 5C0000-5FFFFF, 740000-77FFFF, 7C0000-7FFFFF
       (!A23 & A22 & A20 & A19 & i9 & MAENA_BA & !_A20EN) #                                //580000-5FFFFF, 780000-7FFFFF
       (!A23 & A22 & A21 & i9 & MAENA_BA) #                                                //600000-7FFFFF
       (A23 & !A22 & !A21 & !A20 & i9 & MAENA_BA) #                                        //800000-8FFFFF
       (DACK0 & !MAENA_BA);


//4MB ext3
!4MB_3 = (A23 & A22 & !A21 & !A19 & !A18 & i9 & MAENA_BA) #                                //C00000-C3FFFF, D00000-D3FFFF
       (A23 & !A22 & A20 & A18 & i9 & MAENA_BA & !_A20EN) #                                //940000-97FFFF, 9C0000-9FFFFF, B40000-B7FFFF, BC0000-BFFFFF
       (A23 & !A22 & A20 & A19 & i9 & MAENA_BA & !_A20EN) #                                //980000-9FFFFF, B80000-BFFFFF
       (A23 & !A22 & A21 & i9 & MAENA_BA) #                                                //A00000-AFFFFF
       (A23 & A22 & !A21 & !A20 & i9 & MAENA_BA) #                                         //C00000-CFFFFF
       (DACK0 & !MAENA_BA);

