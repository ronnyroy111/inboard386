Name       U100.pld;
Partno     U100;
Date       ;
Revision   ;
Designer   ;
Company    ;
Assembly   ;
Location   ;
Device     G16V8;
//          16L8

/* INPUT PINS */
PIN  1 = i1;
PIN  2 = i2;
PIN  3 = W_R;
PIN  4 = RESET88;
PIN  5 = 8088_ALE;
PIN  6 = A1;
PIN  7 = A0;
PIN  8 = A2;
PIN  9 = A6;
PIN  11 = _CLK88;
PIN  14 = i14;

/* OUTPUT PINS */
PIN  12 = AtoAD;
PIN  13 = o13;
PIN  15 = 8088D_OE;
PIN  16 = 8088D_CP;
PIN  17 = o17;
PIN  18 = o18;
PIN  19 = o19;

/* LOGIC EQUATIONS */

!AtoAD = (8088_ALE);

!o13 = (!A6 & !o13) #
       (A0 & !o13) #
       (A1 & !o13) #
       (!o13 & !8088D_CP) #
       (!W_R & !o13) #
       (i2 & !o13) #
       (RESET88);

!8088D_OE = (!8088_ALE & !i14);

!8088D_CP = (!RESET88 & !8088_ALE) #
       (_CLK88);

!o17 = (!i2 & !W_R & !A1 & !A0 & A2 & A6);

!o18 = (!i1 & !i2 & W_R & 8088_ALE & !A1 & !A0 & !A2 & A6);

!o19 = (!i2 & W_R & 8088_ALE & !A1 & A0 & !A2 & A6);