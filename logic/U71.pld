!o21 = (DACK0 & !MAENA_BA) #
       (!A22 & A21 & !A20 & !A19 & !A18 & !A23 & i9 & MAENA_BA) #
       (!A22 & !A21 & A20 & A18 & !A23 & i9 & MAENA_BA & !i23) #
